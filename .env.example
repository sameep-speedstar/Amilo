# Amilo API
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://amilo:amilo@localhost:5433/amilo
ALLOWED_PHONES=+91XXXXXXXXXX

# WhatsApp Cloud API (Meta)
WABA_VERIFY_TOKEN=change-me
WABA_APP_SECRET=
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_ACCOUNT_ID=
# Template names must match Meta exactly (submitted, pending approval)
WABA_TEMPLATE_MORNING=morning_update
WABA_TEMPLATE_EVENING=evening_wrap
# After Meta approves v2 bullet templates, switch to:
# WABA_TEMPLATE_MORNING=morning_update_v2
# WABA_TEMPLATE_EVENING=evening_wrap_v2
WABA_TEMPLATE_ALERT=priority_update

# Cursor Agent SDK (cloud) — reserved for heavy triage/briefings (M4/M5), not chat
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_BRAIN_REPO=https://github.com/sameep-speedstar/Amilo
CURSOR_BRAIN_REF=main

# xAI Grok — WhatsApp chat brain (preferred when set)
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
# Research (movies/dining/flights) — reasoning model + web_search (default)
GROK_RESEARCH_MODEL=grok-4-1-fast-reasoning
# Browser OTP booking (Zepto/BMS) — off until partner APIs; Grok search + deep links instead
BROWSER_BOOKING_ENABLED=0

# Google OAuth (M4) — reuse LifeOS client; add redirect URI api.amilo.io/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://api.amilo.io
GOOGLE_REDIRECT_URI=https://api.amilo.io/oauth/google/callback

# Uber Riders API (optional) — create app at developer.uber.com; redirect api.amilo.io/oauth/uber/callback
# Privileged `request` scope: Limited Access = you + up to 5 testers; Full Access needs Uber review.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=https://api.amilo.io/oauth/uber/callback

# Crypto — openssl rand -base64 32 (Amilo-only; do not share LifeOS fernet key)
TOKEN_ENCRYPTION_KEY=

# Voice (Sarvam STT — same provider as LifeOS Telegram)
SARVAM_API_KEY=
# LifeOS live default; override to saaras:v3 if you want the newer model
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE_CODE=unknown
GOOGLE_MAPS_API_KEY=

# Cloud browser bookings (grocery / dining / tickets)
# demo = simulated OTP→cart/COD or pay-link (default); live = Playwright against merchant sites
BROWSER_AGENT_MODE=demo
# AES key for encrypted per-user browser profiles (also use Azure Key Vault in prod)
BROWSER_PROFILE_KEY=
BROWSER_PROFILE_DIR=/tmp/amilo-browser-profiles
# Optional Azure Blob bridge (encrypts to mounted/FS path named by container)
# AZURE_STORAGE_CONNECTION_STRING=
# BROWSER_PROFILE_CONTAINER=browser-profiles
# Set 1 to allow generic any-site beyond allowlist (still spend-capped)
BOOKING_ALLOW_ANY_SITE=0

# Beta admin + invite onboarding
# openssl rand -hex 24  (optional emergency token — prefer email login)
ADMIN_TOKEN=
ADMIN_EMAIL=sameep@speedstar.ai
# openssl rand -base64 24
ADMIN_PASSWORD=
# Business WhatsApp number for wa.me deep links (E.164 digits ok, e.g. +9198…)
WABA_DISPLAY_PHONE=
USAGE_DAY_CAP=40
USAGE_WEEK_CAP=150
# Optional extras (ALLOWED_PHONES + product host are already exempt)
# Optional extras (ALLOWED_PHONES + product host are already exempt)
# HOST_PHONE=+91XXXXXXXXXX
# USAGE_CAP_EXEMPT_PHONES=+91XXXXXXXXXX

# Social posting — X @Amilo_io + Instagram @amilo.io (scripts/social)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
AZURE_STORAGE_ACCOUNT=amilostaticweb
SOCIAL_PUBLIC_BASE=https://amilo.io

# Studio (multi-product publisher at /studio)
# STUDIO_DATA_DIR=data/studio

# Social posting — X @Amilo_io + Instagram @amilo.io (scripts/social)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
AZURE_STORAGE_ACCOUNT=amilostaticweb
SOCIAL_PUBLIC_BASE=https://amilo.io
