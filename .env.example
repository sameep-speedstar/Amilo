# Amilo API
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://amilo:amilo@localhost:5432/amilo
ALLOWED_PHONES=+91XXXXXXXXXX

# WhatsApp Cloud API (Meta)
WABA_VERIFY_TOKEN=change-me
WABA_APP_SECRET=
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
