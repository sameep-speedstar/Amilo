# Amilo API
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://amilo:amilo@localhost:5433/amilo
ALLOWED_PHONES=+91XXXXXXXXXX

# WhatsApp Cloud API (Meta)
WABA_VERIFY_TOKEN=change-me
WABA_APP_SECRET=
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_ACCOUNT_ID=
# Template names must match Meta exactly (submitted, pending approval)
WABA_TEMPLATE_MORNING=morning_update
WABA_TEMPLATE_EVENING=evening_wrap
WABA_TEMPLATE_ALERT=priority_update

# Cursor Agent SDK (cloud) — reserved for heavy triage/briefings (M4/M5), not chat
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_BRAIN_REPO=https://github.com/sameep-speedstar/Amilo
CURSOR_BRAIN_REF=main

# xAI Grok — WhatsApp chat brain (preferred when set)
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning

# Google OAuth (M4) — reuse LifeOS client; add redirect URI api.amilo.io/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://api.amilo.io
GOOGLE_REDIRECT_URI=https://api.amilo.io/oauth/google/callback

# Crypto — openssl rand -base64 32 (Amilo-only; do not share LifeOS fernet key)
TOKEN_ENCRYPTION_KEY=

# Voice (Sarvam STT — same provider as LifeOS Telegram)
SARVAM_API_KEY=
# LifeOS live default; override to saaras:v3 if you want the newer model
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE_CODE=unknown
GOOGLE_MAPS_API_KEY=
