# Cursor Agent SDK (cloud)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_BRAIN_REPO=https://github.com/sameep-speedstar/Amilo
CURSOR_BRAIN_REF=main

# Google OAuth (M4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Crypto
TOKEN_ENCRYPTION_KEY=
