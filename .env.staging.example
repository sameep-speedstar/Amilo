# Staging Amilo API — copy to .env.staging (gitignored)
# Use a dedicated Meta test / second WABA number. Never point prod webhook here.
PORT=8080
NODE_ENV=production
ALLOWED_PHONES=+91XXXXXXXXXX

# Staging WhatsApp Cloud API (separate app or test number)
WABA_VERIFY_TOKEN=change-me-staging
WABA_APP_SECRET=
WABA_ACCESS_TOKEN=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_ACCOUNT_ID=
WABA_TEMPLATE_MORNING=morning_update
WABA_TEMPLATE_EVENING=evening_wrap
WABA_TEMPLATE_ALERT=priority_update
WABA_DISPLAY_PHONE=

CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_BRAIN_REPO=https://github.com/sameep-speedstar/Amilo
CURSOR_BRAIN_REF=main

XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://api-staging.amilo.io
GOOGLE_REDIRECT_URI=https://api-staging.amilo.io/oauth/google/callback

TOKEN_ENCRYPTION_KEY=

SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
SARVAM_LANGUAGE_CODE=unknown
GOOGLE_MAPS_API_KEY=

ADMIN_TOKEN=
ADMIN_EMAIL=sameep@speedstar.ai
ADMIN_PASSWORD=
USAGE_DAY_CAP=40
USAGE_WEEK_CAP=150
# HOST_PHONE=+91XXXXXXXXXX
# USAGE_CAP_EXEMPT_PHONES=+91XXXXXXXXXX
